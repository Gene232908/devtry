# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Twilio (legacy SMS OTP path — superseded by WhatsApp Cloud API below for the
# valuation form, kept for reference/rollback only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign the short-lived post-OTP verify token (legacy Twilio path).
OTP_VERIFY_SECRET=

# DEV OTP bypass — LOCAL TESTING ONLY. When true (and NODE_ENV is not
# production), no real WhatsApp message is sent and the fixed DEV_OTP_CODE
# below is accepted. NEVER set this in Vercel/production.
DEV_OTP_BYPASS=true
DEV_OTP_CODE=123456

# WhatsApp Cloud API (Meta) — used for the valuation form's OTP verification.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1241194132412580
WHATSAPP_WABA_ID=1570029297847556
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=
# Must match the template's language CODE in WhatsApp Manager, not its display
# name — plain "English" is code `en`, while "English (UAE)" would be `en_AE`,
# "English (US)" would be `en_US`, etc. Check the exact template before setting this.
WHATSAPP_TEMPLATE_LANGUAGE=en

# true while using Meta's free test tier (delivery limited to WHATSAPP_TEST_RECIPIENTS).
# Set to false for production, where OTP_PRODUCTION_COUNTRY governs accepted numbers.
WHATSAPP_TEST_MODE=true
# Comma-separated E.164 numbers registered as Meta test recipients. Server-side only.
WHATSAPP_TEST_RECIPIENTS=
OTP_PRODUCTION_COUNTRY=AE

# Emergency circuit breaker for paid WhatsApp OTP sends. Set to false only to
# stop sends during an incident; it is enabled by default when omitted.
# Production changes require a new Vercel deployment to take effect.
WHATSAPP_OTP_SENDING_ENABLED=true

# Secret used to hash OTP codes (HMAC-SHA256) and sign verification proofs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HASH_SECRET=
