# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
# Verification-only build output. `next build` and `next dev` share /.next and
# clobber each other — running a build while the dev server is up strips its
# compiled CSS and the site renders as unstyled HTML. Use `npm run build:check`
# to verify a build without touching a running dev server.
/.next-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

